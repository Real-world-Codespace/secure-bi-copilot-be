OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
FRONTEND_ORIGIN=http://localhost:3000
MAX_QUERY_ROWS=500
QUERY_TIMEOUT_SECONDS=20
DATABASE_URL=postgresql+psycopg://secure_bi:secure_bi@localhost:5432/secure_bi_demo
REDIS_URL=redis://localhost:6379/0
API_RATE_LIMIT_PER_MINUTE=60
LLM_RATE_LIMIT_PER_MINUTE=10
# Smooth provider calls per backend worker. This never replaces Redis quota.
LLM_WORKER_REQUESTS_PER_SECOND=3
LLM_WORKER_MAX_BURST=3
# Use 0 during rate-limit demonstrations to avoid retry calls; production default is 1.
OPENAI_MAX_RETRIES=1
SECURITY_LAB_ENABLED=false
AUTH_SECRET=replace-with-a-long-random-secret
